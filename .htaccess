# Allico Systems. Gaat met bouw.js mee naar de map site/ en hoort in de hoofdmap van de webruimte.
# Werkt de site na het uploaden niet meer (foutmelding of eindeloos laden)? Verwijder dan dit bestand.

# Een adres voor Google. Alles wat niet precies allicosystems.nl is
# (www.allicosystems.nl, allicosystems.com, www.allicosystems.com) gaat blijvend (301)
# naar https://allicosystems.nl, met behoud van het pad.
# (Doorsturen van http naar https op allicosystems.nl zelf: zet dat aan in het STRATO-klantmenu,
# de optie heet in het Duits "SSL erzwingen".)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?allicosystems\.(nl|com)$ [NC]
RewriteCond %{HTTP_HOST} !^allicosystems\.nl$ [NC]
RewriteRule ^(.*)$ https://allicosystems.nl/$1 [R=301,L]

# Een adres dat niet bestaat toont de eigen pagina "niet gevonden" (404.html uit bouw.js)
ErrorDocument 404 /404.html

# Juiste bestandstypen
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType image/x-icon .ico
</IfModule>

# Beelden een maand bewaren in de browser: herhaalbezoeken laden direct
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
