# Allico Systems. Gaat met bouw.js mee naar de map site/ en hoort in de hoofdmap van de webruimte.
# Werkt de site na het uploaden niet meer (foutmelding of eindeloos laden)? Verwijder dan dit bestand.

# Beveiligingsheaders. Elke Header-regel moet op een regel blijven, anders geeft de server foutmelding 500.
# - HSTS staat eerst op een dag (86400). Gaat het een week goed, zet het dan op een jaar (31536000).
# - Ontbreekt na het uploaden opmaak, lettertype of een beeld, of doet het menu of formulier niets? Verwijder dan
#   alleen de regel met Content-Security-Policy en kijk in de console van de browser (F12) wat er werd geweigerd.
# - Vul je formulier.endpoint in data/siteData.js in (bijvoorbeeld Formspree)? Zet dat domein dan achter connect-src,
#   bijvoorbeeld: connect-src 'self' https://formspree.io; anders weigert de browser het versturen.
# - Google Fonts is er op 26-11-2026 uit gehaald (Wessel): de site laadt geen lettertypen of opmaak van andere sites.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=86400; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# Een adres voor Google. Alles wat niet precies allicosystems.nl is
# (www.allicosystems.nl, allicosystems.com, www.allicosystems.com) gaat blijvend (301)
# naar https://allicosystems.nl, met behoud van het pad.
# (Doorsturen van http naar https op allicosystems.nl zelf: zet dat aan in het STRATO-klantmenu,
# de optie heet in het Duits "SSL erzwingen".)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?allicosystems\.(nl|com)$ [NC]
RewriteCond %{HTTP_HOST} !^allicosystems\.nl$ [NC]
RewriteRule ^(.*)$ https://allicosystems.nl/$1 [R=301,L]

# Een adres dat niet bestaat toont de eigen pagina "niet gevonden" (404.html uit bouw.js)
ErrorDocument 404 /404.html

# Juiste bestandstypen
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType image/x-icon .ico
</IfModule>

# Beelden een maand bewaren in de browser: herhaalbezoeken laden direct
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Tekstbestanden ingepakt versturen (gzip): HTML, CSS, JavaScript, SVG, XML en tekst worden 3 tot 6 keer kleiner.
# Staat de module niet aan bij STRATO, dan slaat de server dit blok gewoon over.
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/x-javascript text/plain text/xml application/xml application/json image/svg+xml image/x-icon
    </IfModule>
</IfModule>
